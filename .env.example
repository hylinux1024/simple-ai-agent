# LLM Provider Configuration
# Supported providers: openai, deepseek, anthropic, mock
LLM_PROVIDER=mock

# Model name (e.g., gpt-4o, deepseek-v4-pro, claude-sonnet-4-6)
LLM_MODEL_NAME=mock-model

# API Key (leave empty for mock provider)
LLM_API_KEY=

# Base URL (optional, for compatible APIs like DeepSeek)
LLM_BASE_URL=

# Optional: Default temperature, max_tokens, etc.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
